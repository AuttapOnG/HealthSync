# Local Zepp Life direct-session POC.
# Never commit real token values. ZEPP_APP_TOKEN may expire and should be
# captured only from a user-owned logged-in Zepp/Huami session.
ZEPP_HOST=api-mifit.huami.com
ZEPP_USER_ID=1234567890
ZEPP_APP_TOKEN=replace-with-local-apptoken
ZEPP_DAYS=30

# Local Garmin Connect destination POC.
# Never commit real Garmin credentials or session files.
GARMIN_EMAIL=replace-with-garmin-email
GARMIN_PASSWORD=replace-with-garmin-password
GARMIN_SESSION_DIR=.local/garmin-session
# Optional Garmin read-back verification after upload. Keep false unless you
# intentionally want the Garmin destination to read the uploaded date.
GARMIN_VERIFY_UPLOADS=false

# Local file-backed duplicate-prevention state.
HEALTHSYNC_SYNC_STATE_PATH=data/sync_state.json

# Safety gate for local runner real uploads.
# Keep false unless you are intentionally running:
# python scripts/sync_weight.py --destination garmin --allow-real-upload
HEALTHSYNC_ALLOW_REAL_UPLOAD=false
